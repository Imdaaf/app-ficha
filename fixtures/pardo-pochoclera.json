[{"productId":"105264","productName":"Pochoclera Eléctrica Sin Aceite Máquina De Pochoclos Rojo","brand":"Generic","brandId":2000957,"brandImageUrl":null,"linkText":"pochoclera-electrica-sin-aceite-maquina-de-pochoclos-rojo-105264","productReference":"10523","productReferenceCode":null,"categoryId":"226","productTitle":null,"metaTagDescription":"Pochoclera Eléctrica OM ST-PC-102\nPochoclos calientes y crocantes en minutos ¡sin aceite!\nDisfrutá pochoclos recién hechos en casa de forma rápida, sa","releaseDate":"2026-09-15T00:00:00Z","clusterHighlights":{"1657":"1657 ALL Publicados","1822":"1822 All Pardo Publicados","1876":"1876 Hipotecario","1877":"1877 Hipotecario","1899":"1899 Hipotecario","1914":"1914 Hipotecario 6"},"productClusters":{"1657":"1657 ALL Publicados","1822":"1822 All Pardo Publicados","1853":"1853 Naranja","1876":"1876 Hipotecario","1877":"1877 Hipotecario","1891":"1891 Macro 6csi","1899":"1899 Hipotecario","1914":"1914 Hipotecario 6"},"searchableClusters":{},"categories":["/PEQUEÑOS ELECTRODOMÉSTICOS/PEQUEÑOS HOGAR/","/PEQUEÑOS ELECTRODOMÉSTICOS/"],"categoriesIds":["/224/226/","/224/"],"link":"https://www.pardo.com.ar/pochoclera-electrica-sin-aceite-maquina-de-pochoclos-rojo-105264/p","Compra Internacional":["No"],"Especificações":["Compra Internacional"],"allSpecifications":["Compra Internacional"],"allSpecificationsGroups":["Especificações"],"description":"<p>Pochoclera Eléctrica OM ST-PC-102</p>\n<p>Pochoclos calientes y crocantes en minutos ¡sin aceite!</p>\n<p>Disfrutá pochoclos recién hechos en casa de forma rápida, saludable y práctica.</p>\n<p>La pochoclera eléctrica OM utiliza tecnología de aire caliente por convección, lo que permite preparar palomitas sin aceite ni manteca, reduciendo grasas y manteniendo el sabor natural del maíz.</p>\n<p>En solo 2 a 4 minutos podés tener un bowl lleno de pochoclos listos para disfrutar en familia, ver películas o compartir con amigos.</p>\n<p>Su diseño compacto y moderno incluye recipientes removibles para servir directamente, haciendo que la experiencia sea simple y divertida.</p>\n<p></p>\n<p>Características principales</p>\n<p>* Tecnología de aire caliente por convección</p>\n<p>* No requiere aceite ni manteca</p>\n<p>* Preparación rápida en 2 a 4 minutos</p>\n<p>* Potencia: 1200 W</p>\n<p>* Alimentación: 220-240 V / 50-60 Hz</p>\n<p>* Incluye vaso medidor para porciones exactas</p>\n<p>* Recipientes removibles para servir pochoclos</p>\n<p>* Sistema de cocción uniforme y rápido</p>\n<p></p>\n<p>Beneficios del producto</p>\n<p>- Más saludable</p>\n<p>Prepara pochoclos sin aceite ni grasa agregada.</p>\n<p>- Rápido y práctico</p>\n<p>Listos en pocos minutos sin complicaciones.</p>\n<p>- Ideal para cine en casa</p>\n<p>Perfecto para películas, reuniones o snacks.</p>\n<p>- Gran capacidad</p>\n<p>Permite preparar varias porciones rápidamente.</p>\n<p>- Fácil de usar</p>\n<p>Solo agregás el maíz, encendés y listo.</p>\n<p>- Limpieza sencilla</p>\n<p>Piezas removibles fáciles de limpiar.</p>\n<p></p>\n<p>Especificaciones técnicas</p>\n<p>Modelo: ST-PC-102</p>\n<p>Marca: OM</p>\n<p>Potencia: 1200 W</p>\n<p>Voltaje: 220-240 V</p>\n<p>Frecuencia: 50-60 Hz</p>\n<p>Tiempo de preparación: 2 a 4 minutos</p>\n<p>Capacidad aproximada: 4,5 L</p>\n<p></p>\n<p>* Pochoclos listos en minutos</p>\n<p>* Sin aceite ni manteca</p>\n<p>* Tecnología de aire caliente</p>\n<p>* Ideal para ver películas</p>\n<p>* Preparación rápida y simple</p>\n<p>* Snack saludable para toda la familia</p>\n<p>* Gran capacidad para compartir</p>\n<p>* Diseño práctico y moderno</p>","items":[{"itemId":"126162","name":"Pochoclera Eléctrica Sin Aceite Máquina De Pochoclos Rojo","nameComplete":"Pochoclera Eléctrica Sin Aceite Máquina De Pochoclos Rojo","complementName":"","ean":"","referenceId":[{"Key":"RefId","Value":"10523"}],"measurementUnit":"un","unitMultiplier":1.0000,"modalType":null,"isKit":false,"images":[{"imageId":"922881","imageLabel":null,"imageTag":"<img src=\"~/arquivos/ids/922881-#width#-#h